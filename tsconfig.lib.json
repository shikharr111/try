{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "src/lib/**/__tests__/**",
    "src/lib/server/**",
    "src/lib/supabase/**"
  ]
}