{
  "name": "sitepulse",
  "version": "0.1.0",
  "private": true,
  "description": "SitePulse: construction project monitoring (Next.js + Supabase)",
  "scripts": {
    "test": "tsx --test \"src/lib/**/__tests__/*.test.ts\"",
    "typecheck:calc": "tsc -p tsconfig.lib.json",
    "test:db": "bash supabase/tests/run_db_tests.sh",
    "typecheck:lib": "tsc -p tsconfig.lib.json",
