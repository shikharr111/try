# ---------------------------------------------------------------------------------------------
# SitePulse environment variables.  Copy to .env.local (local) or add in Vercel > Settings > Environment Variables.
# NEVER commit real values.  Only variables prefixed NEXT_PUBLIC_ are sent to the browser.
# ---------------------------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------------------------
# Project URL and the *anon (publishable)* key: Supabase dashboard > Project Settings > API.
# These two are public by design; all data access is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The service-role key is deliberately NOT used anywhere in this application. Do not add it.

# --- Site URL (required in production) --------------------------------------------------------
# Used for e-mail confirmation / password-recovery redirects. Also add it (and /auth/callback)
# under Supabase > Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI delay analysis (optional; the feature is disabled with a clear message when unset) ----
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Model id to use, e.g. a current Claude model from https://docs.claude.com. Required when the key is set.
AI_MODEL=
# Optional: override the API base URL (proxy / gateway). Leave empty for the default.
AI_BASE_URL=
# Optional: per-project daily cap (rolling 24 hours) on analyses (cost control). Default 20.
AI_DAILY_LIMIT_PER_PROJECT=20

# --- Demo mode (optional) ---------------------------------------------------------------------
# When "true", the sign-in page shows the demo accounts created by supabase/seed.sql and a DEMO DATA banner.
# Leave false/unset in production. The demo accounts share a PUBLIC password: never seed them in production.
NEXT_PUBLIC_DEMO_MODE=false
